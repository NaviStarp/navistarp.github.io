---
import Icons from './Icons.astro';

interface Props {
  githubUrl?: string;
  githubUser?: string;
}

const { 
  githubUrl = "https://github.com/navistarp", 
  githubUser = "navistarp" 
} = Astro.props;
---

<header class="dashboard-header">
  <!-- Reloj y fecha en vivo -->
  <div class="clock-widget" id="clock-widget">
    <div class="clock-time font-mono" id="clock-time">--:--</div>
    <div class="clock-date" id="clock-date">Cargando...</div>
  </div>

  <!-- Barra minimalista con GitHub y atajos -->
  <div class="header-actions">
    <a 
      href={githubUrl} 
      target="_blank" 
      rel="noopener noreferrer" 
      class="github-pill"
      title="Ver perfil de GitHub"
    >
      <Icons name="github" class="w-4 h-4" />
      <span>github/{githubUser}</span>
      <Icons name="arrow-up-right" class="w-3 h-3" />
    </a>

    <div class="shortcut-pill font-mono">
      <span class="shortcut-label">Atajos:</span>
      <kbd class="kbd">1</kbd>
      <kbd class="kbd">2</kbd>
      <kbd class="kbd">3</kbd>
    </div>
  </div>
</header>

<script>
  function updateClock() {
    const now = new Date();
    const hours = String(now.getHours()).padStart(2, '0');
    const minutes = String(now.getMinutes()).padStart(2, '0');
    
    const timeElem = document.getElementById('clock-time');
    const dateElem = document.getElementById('clock-date');
    
    if (timeElem) {
      timeElem.textContent = `${hours}:${minutes}`;
    }
    
    if (dateElem) {
      const options: Intl.DateTimeFormatOptions = { 
        weekday: 'long', 
        day: 'numeric', 
        month: 'long' 
      };
      const dateStr = now.toLocaleDateString('es-ES', options);
      dateElem.textContent = dateStr.charAt(0).toUpperCase() + dateStr.slice(1);
    }
  }

  updateClock();
  setInterval(updateClock, 1000);
</script>
